<header class="crm-page-header crm-settings-header"><div><h1 class="crm-page-title">Lý do thắng, lý do thua và đối thủ</h1><p class="crm-page-description">Quản lý ba nhóm dữ liệu cấu hình độc lập phục vụ hoạt động kinh doanh.</p></div></header>
<div class="crm-settings-notices" aria-live="polite"><div id="globalErrorAlert" class="crm-alert crm-alert-danger" hidden role="alert"><div id="globalErrorMessage"></div><button type="button" class="crm-settings-icon" data-dismiss="globalErrorAlert" aria-label="Đóng thông báo lỗi">&times;</button></div><div id="globalSuccessAlert" class="crm-alert crm-alert-success" hidden role="status"><div id="globalSuccessMessage"></div><button type="button" class="crm-settings-icon" data-dismiss="globalSuccessAlert" aria-label="Đóng thông báo">&times;</button></div></div>
<div class="crm-settings-tabs" role="tablist" aria-label="Nhóm dữ liệu"><button type="button" class="crm-btn crm-btn-secondary active" id="tabBtnWin" data-tab="WIN" role="tab" aria-selected="true">Lý do thắng <span class="crm-badge" id="badgeCountWin">0</span></button><button type="button" class="crm-btn crm-btn-secondary" id="tabBtnLoss" data-tab="LOSS" role="tab" aria-selected="false">Lý do thua <span class="crm-badge" id="badgeCountLoss">0</span></button><button type="button" class="crm-btn crm-btn-secondary" id="tabBtnCompetitor" data-tab="COMPETITOR" role="tab" aria-selected="false">Đối thủ cạnh tranh <span class="crm-badge" id="badgeCountComp">0</span></button></div>
<section class="crm-card" id="paneReasons"><header class="crm-card-header"><div><h2 class="crm-card-title" id="reasonsCardTitle">Lý do thắng</h2><p class="crm-settings-summary" id="reasonsCardSubtitle">Đang tải…</p></div><button type="button" class="crm-btn crm-btn-primary" id="btnOpenAddReasonModal" data-create <%= settingsCanManage ? "" : "hidden" %>>Thêm lý do</button></header><div class="crm-card-body"><div class="crm-toolbar crm-settings-toolbar"><input type="search" class="crm-input" id="reasonSearchInput" placeholder="Tìm nội dung hoặc mô tả" aria-label="Tìm lý do"><select class="crm-select" id="reasonStatusFilter" aria-label="Lọc trạng thái"><option value="">Tất cả trạng thái</option><option value="true">Đang sử dụng</option><option value="false">Ngừng sử dụng</option></select><button type="button" class="crm-btn crm-btn-secondary" id="btnReloadWinLoss">Làm mới</button></div><div class="crm-state crm-state-loading" id="wlLoading" hidden>Đang tải dữ liệu…</div><div class="crm-table-wrap" tabindex="0" role="region" aria-label="Bảng lý do, cuộn ngang để xem đủ thông tin"><table class="crm-table crm-settings-table"><thead><tr><th scope="col">Thứ tự</th><th scope="col">Nội dung lý do</th><th scope="col">Mô tả</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead><tbody id="reasonsTableBody"></tbody></table></div></div></section>
<section class="crm-card" id="paneCompetitors" hidden><header class="crm-card-header"><div><h2 class="crm-card-title">Đối thủ cạnh tranh</h2><p class="crm-settings-summary" id="competitorSummary">Đang tải…</p></div><button type="button" class="crm-btn crm-btn-primary" id="btnOpenAddCompetitorModal" data-create <%= settingsCanManage ? "" : "hidden" %>>Thêm đối thủ</button></header><div class="crm-card-body"><div class="crm-toolbar crm-settings-toolbar"><input type="search" class="crm-input" id="competitorSearchInput" placeholder="Tìm tên, điểm mạnh hoặc điểm yếu" aria-label="Tìm đối thủ"><select class="crm-select" id="competitorStatusFilter" aria-label="Lọc trạng thái"><option value="">Tất cả trạng thái</option><option value="true">Đang sử dụng</option><option value="false">Ngừng sử dụng</option></select><button type="button" class="crm-btn crm-btn-secondary" id="btnReloadCompetitors">Làm mới</button></div><div class="crm-table-wrap" tabindex="0" role="region" aria-label="Bảng đối thủ, cuộn ngang để xem đủ thông tin"><table class="crm-table crm-settings-table"><thead><tr><th scope="col">Thứ tự</th><th scope="col">Tên đối thủ</th><th scope="col">Điểm mạnh</th><th scope="col">Điểm yếu</th><th scope="col">Trang web</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead><tbody id="competitorsTableBody"></tbody></table></div></div></section>
</div><div class="crm-modal-overlay" id="reasonModal" hidden role="dialog" aria-modal="true" aria-labelledby="reasonModalTitle"><div class="crm-modal-card"><header class="crm-modal-header"><h2 class="crm-modal-title" id="reasonModalTitle"><span id="reasonModalTitleText">Thêm lý do</span></h2><button type="button" class="crm-modal-close" id="btnCloseReasonModal" data-modal-close aria-label="Đóng biểu mẫu">&times;</button></header><form id="reasonForm" novalidate><div class="crm-modal-body"><div class="crm-alert crm-alert-danger" id="reasonFormError" data-form-error hidden role="alert"></div><input type="hidden" id="reasonId"><input type="hidden" id="reasonType"><div class="crm-form-group"><label class="crm-label" for="reasonText">Nội dung lý do <span class="crm-settings-required">*</span></label><input id="reasonText" name="reasonText" type="text" class="crm-input" required maxlength="255" aria-describedby="feedbackReasonText"><div class="crm-field-error form-feedback" id="feedbackReasonText"></div></div><div class="crm-form-group"><label class="crm-label" for="reasonDesc">Mô tả</label><textarea id="reasonDesc" name="description" class="crm-textarea" rows="3" aria-describedby="feedbackReasonDesc"></textarea><div class="crm-field-error form-feedback" id="feedbackReasonDesc"></div></div><div class="crm-settings-grid"><div class="crm-form-group"><label class="crm-label" for="reasonDisplayOrder">Thứ tự hiển thị <span class="crm-settings-required">*</span></label><input id="reasonDisplayOrder" name="displayOrder" type="number" class="crm-input" required min="0" step="1" value="0" aria-describedby="feedbackReasonOrder"><div class="crm-field-error form-feedback" id="feedbackReasonOrder"></div></div><div class="crm-form-group"><label class="crm-label" for="reasonActive">Trạng thái <span class="crm-settings-required">*</span></label><select id="reasonActive" name="active" class="crm-select" required aria-describedby="feedbackReasonActive"><option value="true">Đang sử dụng</option><option value="false">Ngừng sử dụng</option></select><div class="crm-field-error form-feedback" id="feedbackReasonActive"></div></div></div></div><footer class="crm-modal-footer"><button type="button" class="crm-btn crm-btn-secondary" id="btnCancelReasonModal" data-modal-close>Hủy</button><button type="submit" class="crm-btn crm-btn-primary" id="btnSaveReason">Lưu</button></footer></form></div></div><div class="crm-modal-overlay" id="competitorModal" hidden role="dialog" aria-modal="true" aria-labelledby="compModalTitle"><div class="crm-modal-card"><header class="crm-modal-header"><h2 class="crm-modal-title" id="compModalTitle"><span id="compModalTitleText">Thêm đối thủ cạnh tranh</span></h2><button type="button" class="crm-modal-close" id="btnCloseCompModal" data-modal-close aria-label="Đóng biểu mẫu">&times;</button></header><form id="compForm" novalidate><div class="crm-modal-body"><div class="crm-alert crm-alert-danger" id="compFormError" data-form-error hidden role="alert"></div><input type="hidden" id="compId"><div class="crm-form-group"><label class="crm-label" for="compName">Tên đối thủ <span class="crm-settings-required">*</span></label><input id="compName" name="name" type="text" class="crm-input" required maxlength="255" aria-describedby="feedbackCompName"><div class="crm-field-error form-feedback" id="feedbackCompName"></div></div><div class="crm-form-group"><label class="crm-label" for="compStrengths">Điểm mạnh</label><textarea id="compStrengths" name="strengths" class="crm-textarea" rows="3" aria-describedby="feedbackCompStrengths"></textarea><div class="crm-field-error form-feedback" id="feedbackCompStrengths"></div></div><div class="crm-form-group"><label class="crm-label" for="compWeaknesses">Điểm yếu</label><textarea id="compWeaknesses" name="weaknesses" class="crm-textarea" rows="3" aria-describedby="feedbackCompWeaknesses"></textarea><div class="crm-field-error form-feedback" id="feedbackCompWeaknesses"></div></div><div class="crm-form-group"><label class="crm-label" for="compWebsite">Trang web</label><input id="compWebsite" name="website" type="url" class="crm-input" placeholder="https://example.com" aria-describedby="feedbackCompWebsite"><div class="crm-field-error form-feedback" id="feedbackCompWebsite"></div></div><div class="crm-settings-grid"><div class="crm-form-group"><label class="crm-label" for="compDisplayOrder">Thứ tự hiển thị <span class="crm-settings-required">*</span></label><input id="compDisplayOrder" name="displayOrder" type="number" class="crm-input" required min="0" step="1" value="0" aria-describedby="feedbackCompOrder"><div class="crm-field-error form-feedback" id="feedbackCompOrder"></div></div><div class="crm-form-group"><label class="crm-label" for="compActive">Trạng thái <span class="crm-settings-required">*</span></label><select id="compActive" name="active" class="crm-select" required aria-describedby="feedbackCompActive"><option value="true">Đang sử dụng</option><option value="false">Ngừng sử dụng</option></select><div class="crm-field-error form-feedback" id="feedbackCompActive"></div></div></div></div><footer class="crm-modal-footer"><button type="button" class="crm-btn crm-btn-secondary" id="btnCancelCompModal" data-modal-close>Hủy</button><button type="submit" class="crm-btn crm-btn-primary" id="btnSaveComp">Lưu</button></footer></form></div></div><div class="crm-modal-overlay" id="winLossDeleteModal" hidden role="dialog" aria-modal="true" aria-labelledby="winLossDeleteTitle"><div class="crm-modal-card"><header class="crm-modal-header"><h2 class="crm-modal-title" id="winLossDeleteTitle"><span id="winLossDeleteTitleText">Xác nhận xóa</span></h2><button type="button" class="crm-modal-close" id="btnCloseWinLossDelete" data-modal-close aria-label="Đóng biểu mẫu">&times;</button></header><form id="winLossDeleteForm" novalidate><div class="crm-modal-body"><div class="crm-alert crm-alert-danger" id="winLossDeleteFormError" data-form-error hidden role="alert"></div><p id="winLossDeleteContent"></p></div><footer class="crm-modal-footer"><button type="button" class="crm-btn crm-btn-secondary" id="btnCancelWinLossDelete" data-modal-close>Hủy</button><button type="submit" class="crm-btn crm-btn-primary" id="btnConfirmWinLossDelete">Xóa</button></footer></form></div></div></main></div><jsp:include page="/jsp/shared/footer.jsp" />
<script src="${pageContext.request.contextPath}/js/shared/settings-ui.js" defer></script><script src="${pageContext.request.contextPath}/js/winloss/winloss.js" defer></script></body></html>
