<body class="crm-body"><jsp:include page="/jsp/shared/header.jsp" /><div class="crm-main-layout"><jsp:include page="/jsp/shared/sidebar.jsp" />
<main class="crm-page crm-settings winloss-page" id="winLossApp" data-settings-app data-context-path="${pageContext.request.contextPath}" data-can-manage="<%= settingsCanManage %>"><div class="crm-page-container crm-settings-content winloss-container">
