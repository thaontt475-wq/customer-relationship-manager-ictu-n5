<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<header class="crm-header">
    <div class="crm-header__search">
        <span class="crm-header__search-icon" aria-hidden="true">🔍</span>
        <input type="text" placeholder="Tìm kiếm nhanh khách hàng, lead, ticket..." aria-label="Tìm kiếm">
    </div>

    <div class="crm-header__actions">
        <button type="button" class="crm-header__icon-btn" title="Thông báo" aria-label="Thông báo">
            <span aria-hidden="true">🔔</span>
            <span class="crm-header__badge">3</span>
        </button>

        <button type="button" class="crm-header__icon-btn" title="Cài đặt" aria-label="Cài đặt">
            <span aria-hidden="true">⚙️</span>
        </button>

        <div class="crm-header__user" title="Hồ sơ người dùng">
            <div class="crm-header__avatar">HT</div>
            <div class="crm-header__user-info">
                <span class="crm-header__user-name">Hoàng Thắng</span>
                <span class="crm-header__user-role">Frontend Lead</span>
            </div>
        </div>
    </div>
</header>